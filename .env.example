# Copy to .env and fill in. Keys can also be pasted in the Models page instead
# (stored in data/store/secrets.json, owner-only). Only free-tier keys: no payment method attached.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=

# Optional
# RAG_CONFIG=configs/default.yaml
# RAG_API_URL=http://127.0.0.1:8000
# HF_HUB_OFFLINE=1   # after the local models are downloaded once
# RAG_LOG_FORMAT=json      # one JSON object per log line (default: text)
# RAG_LOG_LEVEL=INFO       # DEBUG adds per-call token usage
# RAG_ALLOWED_HOSTS=       # extra host names the API answers to, comma-separated
# RAG_PRELOAD=0            # do not load the local models at start
